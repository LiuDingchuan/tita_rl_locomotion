    <mesh name="left_wheel_link" file="/usr/share/robot_description/diablo_pluspro/meshes/left_wheel_link.STL"/>
    <mesh name="right_hip_link" file="/usr/share/robot_description/diablo_pluspro/meshes/right_hip_link.STL"/>
    <mesh name="right_knee_link" file="/usr/share/robot_description/diablo_pluspro/meshes/right_knee_link.STL"/>
    <mesh name="right_wheel_link" file="/usr/share/robot_description/diablo_pluspro/meshes/right_wheel_link.STL"/>
