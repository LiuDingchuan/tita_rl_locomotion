    </option>
    <size njmax="500" nconmax="100" />

    <default>
      <default class="diablo_pluspro">
        <joint armature="0.01" damping="0.01"/>
        <default class="visual">
          <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <geom rgba="0.8 0.8 0.8 1" contype="1" conaffinity="1" condim="3" 
          friction="0.6 0.005 0.0001" margin="0.001" group="0" />
      </default>
    </default>
  <asset>
