      <motor name="left_knee_joint"  gear="1"  joint="left_knee_joint" ctrllimited='true' ctrlrange='-60 60'/>
      <motor name="left_wheel_joint" gear="1"  joint="left_wheel_joint" ctrllimited='true' ctrlrange='-20 20'/>
      <motor name="right_hip_joint"  gear="1"  joint="right_hip_joint" ctrllimited='true' ctrlrange='-60 60'/>
      <motor name="right_knee_joint" gear="1"  joint="right_knee_joint" ctrllimited='true' ctrlrange='-60 60'/>
      <motor name="right_wheel_joint" gear="1"  joint="right_wheel_joint" ctrllimited='true' ctrlrange='-20 20'/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_accel" site="imu"/>
    <jointpos name="left_hip_joint" joint="left_hip_joint"/>
    <jointpos name="left_knee_joint" joint="left_knee_joint"/>
    <jointpos name="left_wheel_joint" joint="left_wheel_joint"/>
    <jointpos name="right_hip_joint" joint="right_hip_joint"/>
    <jointpos name="right_knee_joint" joint="right_knee_joint"/>
    <jointpos name="right_wheel_joint" joint="right_wheel_joint"/>
  </sensor>
