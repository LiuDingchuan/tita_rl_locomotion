<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diablo_pluspro">
  <xacro:macro name="description">
    <!-- Base Link -->
    <link name="base_link">
      <inertial>
        <origin xyz="0.0028918 -0.00051043 0.10837" rpy="0 0 0" />
        <mass value="16.387" />
        <inertia ixx="0.60138" ixy="0.061341" ixz="-0.0046441" iyy="0.61933" iyz="-0.0029737" izz="0.35943" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/base_link.STL" />
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/base_link.STL" />
        </geometry>
      </collision>
    </link>

    <link name="imu_link">
      <inertial>
        <mass value="0.001"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.001 0.001 0.001"/>
        </geometry>
        <material name="red"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size=".001 .001 .001"/>
        </geometry>
      </collision>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin rpy="0 0 0" xyz="0 0 0.261"/>
    </joint>

    <!-- Left Hip Link -->
    <link name="left_hip_link">
      <inertial>
        <origin xyz="-0.011467728 -0.02835837 -0.012566631" rpy="0 0 0" />
        <mass value="2.3922754" />
        <inertia ixx="0.0070710282" ixy="0.000789506" ixz="-0.0028025098" iyy="0.01026065" iyz="0.00084909219" izz="0.0064323139" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/left_hip_link.STL" />
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/left_hip_link.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="left_hip_joint" type="revolute">
      <origin xyz="0 0.14844 0" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="left_hip_link" />
      <axis xyz="0 1 0" />
      <dynamics damping="1.0" friction="0.0" />
      <limit lower="-3.14" upper="3.14" effort="60" velocity="15" />
    </joint>

    <!-- Left Knee Link -->
    <link name="left_knee_link">
      <inertial>
        <origin xyz="0.05294369 -0.0059746 -0.081982" rpy="0 0 0" />
        <mass value="0.55812" />
        <inertia ixx="0.0025243498" ixy="-0.00017563529" ixz="0.0022661712" iyy="0.0049635874" iyz="0.00017430388" izz="0.0025562876" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/left_knee_link.STL" />
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/left_knee_link.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="left_knee_joint" type="revolute">
      <origin xyz="-0.12022 0 -0.15983" rpy="0 0 0" />
      <parent link="left_hip_link" />
      <child link="left_knee_link" />
      <axis xyz="0 1 0" />
      <dynamics damping="1.0" friction="0.0" />
      <limit lower="-1.19" upper="0" effort="60" velocity="15" />
    </joint>

    <!-- Left Wheel Link -->
    <link name="left_wheel_link">
      <inertial>
        <origin xyz="0 0.053106868 0" rpy="0 0 0" />
        <mass value="2.785" />
        <inertia ixx="0.037393423" ixy="3.1796E-07" ixz="0" iyy="0.073815378" iyz="0" izz="0.037393397" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/left_wheel_link.STL" />
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0.053 0" rpy="1.5707963 0 0" />
        <geometry>
          <cylinder radius="0.16" length="0.035"/>
        </geometry>
      </collision>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <origin xyz="0.13397 0 -0.1485" rpy="0 0 0" />
      <parent link="left_knee_link" />
      <child link="left_wheel_link" />
      <axis xyz="0 1 0" />
      <dynamics friction="0.01" />
      <limit lower="-1000000" upper="1000000" effort="20" velocity="30" />
    </joint>

    <!-- Right Hip Link -->
    <link name="right_hip_link">
      <inertial>
        <origin xyz="-0.011467728 0.028358373 -0.012566631" rpy="0 0 0" />
        <mass value="2.3922754" />
        <inertia ixx="0.0070710282" ixy="0.000789506" ixz="-0.0028025098" iyy="0.01026065" iyz="0.00084909219" izz="0.0064323139" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/right_hip_link.STL" />
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/right_hip_link.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="right_hip_joint" type="revolute">
      <origin xyz="0 -0.1484 0" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="right_hip_link" />
      <axis xyz="0 1 0" />
      <dynamics damping="1.0" friction="0.0" />
      <limit lower="-3.14" upper="3.14" effort="60" velocity="15" />
    </joint>

    <!-- Right Knee Link -->
    <link name="right_knee_link">
      <inertial>
        <origin xyz="0.05294369 0.0059746 -0.081982" rpy="0 0 0" />
        <mass value="0.55812" />
        <inertia ixx="0.0025243498" ixy="-0.00017563529" ixz="0.0022661712" iyy="0.0049635874" iyz="0.00017430388" izz="0.0025562876" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/right_knee_link.STL" />
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/right_knee_link.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="right_knee_joint" type="revolute">
      <origin xyz="-0.12022 0 -0.15983" rpy="0 0 0" />
      <parent link="right_hip_link" />
      <child link="right_knee_link" />
      <axis xyz="0 1 0" />
      <dynamics damping="1.0" friction="0.0" />
      <limit lower="-1.19" upper="0" effort="60" velocity="15" />
    </joint>

    <!-- Right Wheel Link -->
    <link name="right_wheel_link">
      <inertial>
        <origin xyz="0 -0.053106868 0" rpy="0 0 0" />
        <mass value="2.785" />
        <inertia ixx="0.037393423" ixy="3.1796E-07" ixz="0" iyy="0.073815378" iyz="0" izz="0.037393397" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find tita_description)/diablo_pluspro/meshes/right_wheel_link.STL" />
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 -0.053 0" rpy="1.5707963 0 0" />
        <geometry>
          <cylinder radius="0.16" length="0.035"/>
        </geometry>
      </collision>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <origin xyz="0.13397 0 -0.1485" rpy="0 0 0" />
      <parent link="right_knee_link" />
      <child link="right_wheel_link" />
      <axis xyz="0 1 0" />
      <dynamics friction="0.01" />
      <limit lower="-1000000" upper="1000000" effort="20" velocity="30" />
    </joint>
  </xacro:macro>
</robot>