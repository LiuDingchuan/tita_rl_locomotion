<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================================================================== -->
    <!--                         Adjustable Parameters                      -->
    <!-- ================================================================== -->
    
    <!-- IMU Settings -->
    <xacro:property name="imu_update_rate" value="500.0"/>
    
    <!-- Leg Link Friction (Hip, Thigh, Calf) -->
    <xacro:property name="leg_mu1" value="0.2"/>
    <xacro:property name="leg_mu2" value="0.2"/>
    <xacro:property name="leg_kp" value="1000000.0"/>
    <xacro:property name="leg_kd" value="100.0"/>

    <!-- Foot/Wheel Friction (High friction for traction) -->
    <xacro:property name="foot_mu1" value="2.0"/>
    <xacro:property name="foot_mu2" value="2.0"/>
    <xacro:property name="foot_kp" value="1000000.0"/>
    <xacro:property name="foot_kd" value="100.0"/>

    <!-- ================================================================== -->
    <!--                         Gazebo Plugins                             -->
    <!-- ================================================================== -->

    <!-- IMU Plugin -->
    <gazebo reference="imu_link">
        <gravity>true</gravity>
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>${imu_update_rate}</update_rate>
            <visualize>true</visualize>
            <topic>__default_topic__</topic>
            <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
                <topicName>trunk_imu</topicName>
                <bodyName>imu_link</bodyName>
                <updateRateHZ>${imu_update_rate}</updateRateHZ>
                <gaussianNoise>0.0</gaussianNoise>
                <xyzOffset>0 0 0</xyzOffset>
                <rpyOffset>0 0 0</rpyOffset>
                <frameName>imu_link</frameName>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
            </plugin>
            <pose>0 0 0 0 0 0</pose>
        </sensor>
    </gazebo>

    <!-- ================================================================== -->
    <!--                         Link Properties                            -->
    <!-- ================================================================== -->

    <gazebo reference="imu_link">
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <material>Gazebo/Red</material>
    </gazebo>

    <!-- Left Leg -->
    <gazebo reference="FL_hip">
        <mu1>${leg_mu1}</mu1>
        <mu2>${leg_mu2}</mu2>
    </gazebo>
    <gazebo reference="FL_thigh">
        <mu1>${leg_mu1}</mu1>
        <mu2>${leg_mu2}</mu2>
    </gazebo>
    <gazebo reference="FL_calf">
        <mu1>${leg_mu1}</mu1>
        <mu2>${leg_mu2}</mu2>
        <kp>${leg_kp}</kp>
        <kd>${leg_kd}</kd>
        <self_collide>0</self_collide>
    </gazebo>
    <gazebo reference="FL_foot">
        <mu1>${foot_mu1}</mu1>
        <mu2>${foot_mu2}</mu2>
        <kp>${foot_kp}</kp>
        <kd>${foot_kd}</kd>
        <self_collide>1</self_collide>
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- Right Leg -->
    <gazebo reference="FR_hip">
        <mu1>${leg_mu1}</mu1>
        <mu2>${leg_mu2}</mu2>
    </gazebo>
    <gazebo reference="FR_thigh">
        <mu1>${leg_mu1}</mu1>
        <mu2>${leg_mu2}</mu2>
    </gazebo>
    <gazebo reference="FR_calf">
        <mu1>${leg_mu1}</mu1>
        <mu2>${leg_mu2}</mu2>
        <kp>${leg_kp}</kp>
        <kd>${leg_kd}</kd>
        <self_collide>0</self_collide>
    </gazebo>
    <gazebo reference="FR_foot">
        <mu1>${foot_mu1}</mu1>
        <mu2>${foot_mu2}</mu2>
        <kp>${foot_kp}</kp>
        <kd>${foot_kd}</kd>
        <self_collide>1</self_collide>
        <material>Gazebo/White</material>
    </gazebo>

</robot>
