<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="description">
    
    <!-- Dynamics and Limits Properties -->
    <!-- Hip -->
    <xacro:property name="hip_damping" value="0.0"/>
    <xacro:property name="hip_friction" value="0.0"/>
    <xacro:property name="hip_effort_limit" value="80.0"/>
    <xacro:property name="hip_velocity_limit" value="20.0"/>

    <!-- Thigh -->
    <xacro:property name="thigh_damping" value="0.0"/>
    <xacro:property name="thigh_friction" value="0.0"/>
    <xacro:property name="thigh_effort_limit" value="80.0"/>
    <xacro:property name="thigh_velocity_limit" value="20.0"/>

    <!-- Calf -->
    <xacro:property name="calf_damping" value="0.0"/>
    <xacro:property name="calf_friction" value="0.0"/>
    <xacro:property name="calf_effort_limit" value="80.0"/>
    <xacro:property name="calf_velocity_limit" value="20.0"/>

    <!-- Foot (Wheel) -->
    <xacro:property name="foot_damping" value="0.0"/>
    <xacro:property name="foot_friction" value="0.0"/>
    <xacro:property name="foot_effort_limit" value="20.0"/>
    <xacro:property name="foot_velocity_limit" value="30.0"/>

    <!-- Base Link (Dummy) -->
    <link name="base_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <inertial>
        <mass value="0.001"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <link name="imu_link">
      <inertial>
        <mass value="0.001"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.001 0.001 0.001"/>
        </geometry>
        <material name="red"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size=".001 .001 .001"/>
        </geometry>
      </collision>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <!-- Base link -->
    <link name="F_base_link">
      <inertial>
        <origin rpy="0 0 0" xyz="0.01914869 0.00165406 -0.0256128"/>
        <mass value="11.32539394"/>
        <inertia ixx="0.09049124" ixy="0.00382584" ixz="-0.00543795" iyy="0.19285942" iyz="-4.296e-05" izz="0.18535275"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/base_link.STL"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.375 0.15 0.19"/>
        </geometry>
      </collision>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 -0.13"/>
        <geometry>
          <box size="0.31 0.12 0.06"/>
        </geometry>
      </collision>
    </link>
    <joint name="F_base_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="base_link"/>
      <child link="F_base_link"/>
    </joint>

    <!-- Left hip link -->
    <link name="FL_hip">
      <inertial>
        <origin rpy="0 0 0" xyz="-0.01814352 -7.96e-06 -0.09365134"/>
        <mass value="1.69464273"/>
        <inertia ixx="0.00379266" ixy="-1.1e-07" ixz="-2.452e-05" iyy="0.00276068" iyz="3.09e-06" izz="0.00214485"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/L_hip.STL"/>
        </geometry>
        <material name="silver"/>
      </visual>
    </link>
    <joint name="FL_hip_joint" type="revolute">
      <origin rpy="1.5708 0 1.5708" xyz="0.0945 0.0775 0"/>
      <parent link="F_base_link"/>
      <child link="FL_hip"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${hip_damping}" friction="${hip_friction}"/>
      <limit effort="${hip_effort_limit}" lower="-0.7853981633974483" upper="0.7853981633974483" velocity="${hip_velocity_limit}"/>
    </joint>

    <!-- Left thigh link -->
    <link name="FL_thigh">
      <inertial>
        <origin rpy="0 0 0" xyz="0.02895091 0.00356333 -0.02811556"/>
        <mass value="2.55232244"/>
        <inertia ixx="0.00426053" ixy="-0.00133627" ixz="-0.00212533" iyy="0.01734276" iyz="-0.00029985" izz="0.05"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/L_thigh.STL"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin rpy="0 0 0.2617993877991494" xyz="0.06 0.02 0"/>
        <geometry>
          <box size="0.26 0.09 0.05"/>
        </geometry>
      </collision>
    </link>
    <joint name="FL_thigh_joint" type="revolute">
      <origin rpy="-1.5708 0 -1.5704" xyz="0.0905 0 -0.0945"/>
      <parent link="FL_hip"/>
      <child link="FL_thigh"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${thigh_damping}" friction="${thigh_friction}"/>
      <limit effort="${thigh_effort_limit}" lower="-1.8325957145940461" upper="3.4033920413889422" velocity="${thigh_velocity_limit}"/>
    </joint>

    <!-- Left knee link -->
    <link name="FL_calf">
      <inertial>
        <origin rpy="0 0 0" xyz="0.12506267 0.00606587 0.00312587"/>
        <mass value="0.46345045"/>
        <inertia ixx="0.00023821" ixy="0.00034272" ixz="-0.00014416" iyy="0.00488539" iyz="3.83e-06" izz="0.00493944"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/L_calf.STL"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin rpy="0 0 -0.08" xyz="0.15 0.01 0"/>
        <geometry>
          <box size="0.24 0.04 0.05"/>
        </geometry>
      </collision>
    </link>
    <joint name="FL_calf_joint" type="revolute">
      <origin rpy="-0.0 0.0 0.0" xyz="0.25 0 0"/>
      <parent link="FL_thigh"/>
      <child link="FL_calf"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${calf_damping}" friction="${calf_friction}"/>
      <limit effort="${calf_effort_limit}" lower="-2.775" upper="-0.855" velocity="${calf_velocity_limit}"/>
    </joint>

    <!-- Left wheel link -->
    <link name="FL_foot">
      <inertial>
        <origin rpy="0 0 0" xyz="-2.82e-06 0.0 -0.00091845"/>
        <mass value="1.6631"/>
        <inertia ixx="0.00397025" ixy="2.224e-05" ixz="2.1e-07" iyy="0.00395149" iyz="2e-07" izz="0.00760863"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/L_foot.STL"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.0"/>
        <geometry>
          <cylinder length="0.04" radius="0.087"/>
        </geometry>
      </collision>
    </link>
    <joint name="FL_foot_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0.25 0 0.052166"/>
      <parent link="FL_calf"/>
      <child link="FL_foot"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${foot_damping}" friction="${foot_friction}"/>
      <limit effort="${foot_effort_limit}" lower="-1000000.0" upper="1000000.0" velocity="${foot_velocity_limit}"/>
    </joint>

    <!-- Right hip link -->
    <link name="FR_hip">
      <inertial>
        <origin rpy="0 0 0" xyz="0.01814352 -8e-06 -0.09365134"/>
        <mass value="1.69464279"/>
        <inertia ixx="0.00379266" ixy="1.1e-07" ixz="2.452e-05" iyy="0.00276068" iyz="3.09e-06" izz="0.00214485"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/R_hip.STL"/>
        </geometry>
        <material name="silver"/>
      </visual>
    </link>
    <joint name="FR_hip_joint" type="revolute">
      <origin rpy="1.5708 0 1.5708" xyz="0.0945 -0.0775 0"/>
      <parent link="F_base_link"/>
      <child link="FR_hip"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${hip_damping}" friction="${hip_friction}"/>
      <limit effort="${hip_effort_limit}" lower="-0.7853981633974483" upper="0.7853981633974483" velocity="${hip_velocity_limit}"/>
    </joint>

    <!-- Right thigh link -->
    <link name="FR_thigh">
      <inertial>
        <origin rpy="0 0 0" xyz="0.0291816 0.00370278 0.02811568"/>
        <mass value="2.55232278"/>
        <inertia ixx="0.00427405" ixy="-0.00133225" ixz="0.00213801" iyy="0.01729241" iyz="0.00030751" izz="0.05"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/R_thigh.STL"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin rpy="0 0 0.2617993877991494" xyz="0.06 0.02 0"/>
        <geometry>
          <box size="0.26 0.09 0.05"/>
        </geometry>
      </collision>
    </link>
    <joint name="FR_thigh_joint" type="revolute">
      <origin rpy="-1.5708 0 -1.5712" xyz="-0.0905 0 -0.0945"/>
      <parent link="FR_hip"/>
      <child link="FR_thigh"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${thigh_damping}" friction="${thigh_friction}"/>
      <limit effort="${thigh_effort_limit}" lower="-1.8325957145940461" upper="3.4033920413889422" velocity="${thigh_velocity_limit}"/>
    </joint>

    <!-- Right knee link -->
    <link name="FR_calf">
      <inertial>
        <origin rpy="0 0 0" xyz="0.12506359 0.00606606 -0.0031258"/>
        <mass value="0.46345511"/>
        <inertia ixx="0.00023821" ixy="0.00034271" ixz="0.00014415" iyy="0.00488543" iyz="-3.83e-06" izz="0.00493948"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/R_calf.STL"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin rpy="0 0 -0.08" xyz="0.15 0.01 0"/>
        <geometry>
          <box size="0.24 0.04 0.05"/>
        </geometry>
      </collision>
    </link>
    <joint name="FR_calf_joint" type="revolute">
      <origin rpy="0.0 0.0 0.0" xyz="0.25 0 0"/>
      <parent link="FR_thigh"/>
      <child link="FR_calf"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${calf_damping}" friction="${calf_friction}"/>
      <limit effort="${calf_effort_limit}" lower="-2.775" upper="-0.855" velocity="${calf_velocity_limit}"/>
    </joint>

    <!-- Right wheel link -->
    <link name="FR_foot">
      <inertial>
        <origin rpy="0 0 0" xyz="-2.78e-06 0.0 0.00091859"/>
        <mass value="1.6631"/>
        <inertia ixx="0.00397018" ixy="2.222e-05" ixz="-2.1e-07" iyy="0.00395159" iyz="-2e-07" izz="0.00760867"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://tita_description/ddt_b1/meshes/R_foot.STL"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 -0.0"/>
        <geometry>
          <cylinder length="0.04" radius="0.087"/>
        </geometry>
      </collision>
    </link>
    <joint name="FR_foot_joint" type="revolute">
      <origin rpy="0 0 2.3965" xyz="0.25 0 -0.052166"/>
      <parent link="FR_calf"/>
      <child link="FR_foot"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${foot_damping}" friction="${foot_friction}"/>
      <limit effort="${foot_effort_limit}" lower="-1000000.0" upper="1000000.0" velocity="${foot_velocity_limit}"/>
    </joint>

  </xacro:macro>
</robot>
